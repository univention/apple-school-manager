#
# Script that runs in docker host before installing the app.
#

while [ $# -gt 0 ]; do
	case "$1" in
        "--error-file")
			shift
			errorfile="$1"
			shift
			;;
        "--old-version")
			shift
			old_version="$1"
			shift
			;;
		*)
			shift
			;;
	esac
done

# Issue univention/dev/education/apple-school-manager#15
# block the update to the newest version of Apple School Manager Connector if
# the installed version if UCS@school is smaller than 5.2v5
SCHOOL_LIB_VERSION_MINIMUM="15.2.0"
SCHOOL_LIB_VERSION="$(LANG=C dpkg-query -W -f '${Version}\n' python3-ucsschool-lib 2>&1)"
if dpkg --compare-versions "$SCHOOL_LIB_VERSION" lt-nl "$SCHOOL_LIB_VERSION_MINIMUM" ; then
        message="
Apple School Manager Connector update aborted:
Please update UCS@school ID app​ to at least version 5.2v5
before retrying the Apple School Manager Connector update (your currently installed version is ${old_version}).
"
        echo -e "$message" > "$errorfile"
        exit 1
fi

exit 0
