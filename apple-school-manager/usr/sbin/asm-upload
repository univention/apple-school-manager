import sys
import logging
import json
from json import JSONDecodeError
from logging import FileHandler
from paramiko.ssh_exception import SSHException, NoValidConnectionsError
from univention.asm.asm_upload import ASMUpload
from univention.asm.utils import get_ucr


LOGFILE_PATH = '/var/log/univention/asm.log'
PASSWORD_FILE_PATH = '/etc/asm.secret'
CONFIG_FILE_PATH = '/etc/univention-asm-connector.json'

ucr = get_ucr()


class ASMCredentialError(Exception):
	pass


def get_configs():
	delete_zip = ucr.is_false('asm/store_zip')
	config_file = ucr.get('asm/config_file', CONFIG_FILE_PATH)
	logger.info(f"Using config file {config_file}")
	configs = []
	try:
		with open(config_file, "r") as fd:
			json_conf = json.load(fd)
	except JSONDecodeError:
		raise ASMCredentialError("Invalid json config")
	except FileNotFoundError:
		raise ASMCredentialError(f"Config file could not be found at {config_file}")
	for _conf in json_conf:
		try:
			username = _conf['username']
			password_file = _conf['password']
			with open(password_file, "r") as fd:
				password = fd.read().strip()
			school_whitelist = _conf['school_whitelist']
			configs.append((username, password, school_whitelist))
		except (KeyError, AttributeError):
			raise ASMCredentialError("Incomplete configuration")
		except FileNotFoundError:
			raise ASMCredentialError(f"Password file could not be found at {password_file}")
	return configs, delete_zip


def setup_logging(level_console=logging.INFO, level_file=logging.DEBUG):
	handler_console = logging.StreamHandler()
	handler_console.setLevel(level_console)
	handler_file = FileHandler(LOGFILE_PATH)
	handler_file.setLevel(level_file)
	formatter_file = logging.Formatter('%(asctime)s %(levelname)-5s %(module)s.%(funcName)s:%(lineno)d - %(message)s')
	handler_file.setFormatter(formatter_file)
	logger = logging.getLogger('univention.asm')
	logger.setLevel(logging.DEBUG)
	logger.addHandler(handler_console)
	logger.addHandler(handler_file)


logger = logging.getLogger('univention.asm.upload_script')
setup_logging()


def main():
	try:
		configs, delete_zip = get_configs()
	except ASMCredentialError as exc:
		logger.error(exc)
		sys.exit(1)
	for config in configs:
		asmUpload = ASMUpload(*config, delete_zip_file=delete_zip)
		try:
			zip_path = asmUpload.upload()
		except (SSHException, NoValidConnectionsError) as exc:
			logger.error("SFTP upload failed: {}".format(exc))
			sys.exit(1)
		if not delete_zip and zip_path is not None:
			logger.info("The uploaded zip is stored in: {}".format(zip_path))


if __name__ == '__main__':
	main()
