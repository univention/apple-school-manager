import logging
import sys
from datetime import datetime
from logging import FileHandler

from paramiko.ssh_exception import NoValidConnectionsError, SSHException
from ucsschool.lib.models.school import School
from univention.admin import uexceptions
from univention.asm.asm_upload import ASMUpload
from univention.asm.config import ASMConfigError, check_schools, get_connections
from univention.asm.network.sftp_upload import MissingPublicSshKeyError
from univention.asm.utils import get_ldap_connection, get_ucr
from univention.config_registry import handler_set

LOGFILE_PATH = "/var/log/univention/asm.log"
UCR_STORE_ZIP_KEY = "asm/store_zip"


def setup_logging(level_console: int = logging.INFO, level_file: int = logging.DEBUG) -> None:
    handler_console = logging.StreamHandler()
    handler_console.setLevel(level_console)
    handler_file = FileHandler(LOGFILE_PATH)
    handler_file.setLevel(level_file)
    formatter_file = logging.Formatter(
        "%(asctime)s %(levelname)-5s %(module)s.%(funcName)s:%(lineno)d - %(message)s",
    )
    handler_file.setFormatter(formatter_file)
    logger = logging.getLogger("univention.asm")
    logger.setLevel(logging.DEBUG)
    logger.addHandler(handler_console)
    logger.addHandler(handler_file)


def main() -> None:
    logger = logging.getLogger("univention.asm.upload_script")
    setup_logging()
    try:
        connections = get_connections()
        lo, _po = get_ldap_connection()
        connections = check_schools(connections, [school.name for school in School.get_all(lo)])
    except ASMConfigError as exc:
        logger.error(exc)  # noqa: TRY400
        logger.debug("Traceback of the configuration error:", exc_info=True)
        sys.exit(1)
    delete_zip = not get_ucr().is_true(UCR_STORE_ZIP_KEY)
    failed = []
    for connection in connections:
        logger.info(f"Synchronizing to Apple School Manager account {connection.name}...")
        try:
            asmUpload = ASMUpload(
                connection.username,
                connection.password,
                connection.settings,
                delete_zip,
            )
            zip_path = asmUpload.upload()
        except (SSHException, NoValidConnectionsError, MissingPublicSshKeyError) as exc:
            logger.exception(f"SFTP upload for account {connection.name} failed: {exc}")
            failed.append(connection.name)
            continue
        except uexceptions.valueInvalidSyntax:
            logger.exception(f"Invalid LDAP filter, nothing uploaded to account {connection.name}.")
            failed.append(connection.name)
            continue
        except Exception:
            logger.exception(f"Upload to account {connection.name} failed.")
            failed.append(connection.name)
            continue
        now = datetime.now().isoformat()
        handler_set([f"asm/last_upload={now}", f"asm/last_upload/{connection.name}={now}"])
        if not delete_zip and zip_path is not None:
            logger.info(f"The uploaded zip is stored in: {zip_path}")
    if failed:
        logger.error(f"Upload failed for: {', '.join(failed)}")
        sys.exit(1)


if __name__ == "__main__":
    main()
