"Bindestrich."

#: ../../synchronization.rst:342
msgid "``student_id``"
msgstr "``student_id``"

#: ../../synchronization.rst:343
msgid "The ``person_id`` of the student."
msgstr "Die ``person_id`` des Schülers."

